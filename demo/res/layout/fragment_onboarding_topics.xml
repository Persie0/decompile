<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:transitionGroup="true"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout android:id="@id/appbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:elevation="0.0dp" app:elevation="0.0dp">
        <com.google.android.material.appbar.MaterialToolbar android:id="@id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </com.google.android.material.appbar.AppBarLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/viewContent" android:layout_width="match_parent" android:layout_height="match_parent" android:weightSum="10.0" android:layout_above="@id/tv_continue" android:layout_below="@id/appbar" android:paddingStart="@dimen/activity_horizontal_margin" android:paddingEnd="@dimen/activity_horizontal_margin">
        <TextView android:gravity="center" android:id="@id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="@dimen/list_vertical_margin" android:text="@string/welcome_what_topics_love" android:paddingStart="@dimen/activity_horizontal_margin" android:paddingEnd="@dimen/activity_horizontal_margin" style="@style/TitleLarge" />
        <TextView android:gravity="center" android:id="@id/tv_title_desc" android:paddingBottom="@dimen/activity_vertical_margin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/feed_topics_please_choose_at_least" android:paddingStart="@dimen/activity_horizontal_margin" android:paddingEnd="@dimen/activity_horizontal_margin" style="@style/BodyMedium" />
        <androidx.recyclerview.widget.RecyclerView android:layout_gravity="center" android:id="@id/rv_content" android:paddingBottom="@dimen/activity_vertical_margin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/onboarding_topics_recycler_margin" android:layout_marginEnd="@dimen/onboarding_topics_recycler_margin" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@id/tv_continue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ui_continue" android:layout_alignParentBottom="true" android:layout_marginStart="@dimen/onboarding_topics_button_margin" android:layout_marginEnd="@dimen/onboarding_topics_button_margin" style="@style/OnboardingButton" />
</RelativeLayout>
