            <FrameLayout android:id="@id/viewPlaylist" android:background="@drawable/dr_round_shadow_dark" android:clipChildren="false" android:clipToPadding="false" android:layout_width="@dimen/home_toolbar_flag_size" android:layout_height="@dimen/home_toolbar_flag_size" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
