<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/nav_graph_lesson_info" app:startDestination="@id/fragment_lesson_info"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/nav_graph_search" />
    <dialog android:label="Lesson Info" android:name="com.lingq.feature.lessoninfo.LessonInfoFragment" android:id="@id/fragment_lesson_info">
        <argument android:name="lessonId" app:argType="integer" />
        <argument android:name="title" app:argType="string" />
        <argument android:name="imageURL" app:argType="string" />
        <argument android:name="originalImageUrl" app:argType="string" app:nullable="true" />
        <argument android:name="description" app:argType="string" />
        <argument android:name="from" app:argType="com.lingq.core.ui.LessonInfoSource" />
        <argument android:name="shelfCode" app:argType="string" />
        <action android:id="@id/actionToSearch" app:destination="@id/nav_graph_search" />
        <action android:id="@id/actionToReaderCompose" app:destination="@id/nav_graph_reader" />
        <action android:id="@id/actionToCollection" app:destination="@id/nav_graph_collection" />
        <action android:id="@id/actionToLessonPreview" app:destination="@id/nav_graph_lesson_preview" />
    </dialog>
    <action android:id="@id/actionToLessonInfo" app:destination="@id/fragment_lesson_info" />
</navigation>
