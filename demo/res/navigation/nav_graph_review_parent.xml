<?xml version="1.0" encoding="utf-8"?>
<navigation android:id="@id/nav_graph_review_parent" app:startDestination="@id/fragment_review"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <include app:graph="@navigation/nav_graph_settings_review" />
    <include app:graph="@navigation/nav_graph_token_parent" />
    <include app:graph="@navigation/nav_graph_web_view" />
    <fragment android:label="Review" android:name="com.lingq.feature.review.ReviewFragment" android:id="@id/fragment_review">
        <argument android:name="lessonId" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="reviewType" android:defaultValue="All" app:argType="com.lingq.core.domain.model.review.ReviewType" />
        <argument android:name="isDailyLingQs" android:defaultValue="false" app:argType="boolean" />
        <argument android:name="isFromVocabulary" android:defaultValue="false" app:argType="boolean" />
        <argument android:name="sentenceIndex" android:defaultValue="-1" app:argType="integer" />
        <argument android:name="reviewLanguageFromDeeplink" android:defaultValue="" app:argType="string" />
        <argument android:name="lotd" android:defaultValue="@null" app:argType="string" app:nullable="true" />
        <argument android:name="statusUpper" android:defaultValue="Known" app:argType="com.lingq.core.domain.model.status.CardStatus" />
        <argument android:name="reviewLocation" android:defaultValue="" app:argType="string" />
        <action android:id="@id/actionToReviewSettings" app:destination="@id/nav_graph_settings_review" app:launchSingleTop="true" app:popUpTo="@id/nav_graph_settings_review" app:popUpToInclusive="true" />
        <action android:id="@id/actionToTokenParent" app:destination="@id/nav_graph_token_parent" />
        <action android:id="@id/actionToWeb" app:destination="@id/nav_graph_web_view" />
    </fragment>
    <action android:id="@id/actionToReview" app:destination="@id/fragment_review" />
</navigation>
