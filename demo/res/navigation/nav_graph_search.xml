        <argument android:name="title" app:argType="string" />
        <argument android:name="tabSelected" android:defaultValue="@null" app:argType="com.lingq.core.navigation.model.LibraryTabNavArg" app:nullable="true" />
        <argument android:name="query" android:defaultValue="" app:argType="string" />
        <action android:id="@id/actionToCollectionsLevel" app:destination="@id/fragment_collections_level" />
        <action android:id="@id/actionToLessonInfo" app:destination="@id/nav_graph_lesson_info" />
        <action android:id="@id/actionToLessonPreview" app:destination="@id/nav_graph_lesson_preview" />
