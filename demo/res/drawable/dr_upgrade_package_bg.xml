<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/btn_stroke_width_high" android:color="@color/upgrade_selection" />
            <solid android:color="@color/upgrade_selection" />
            <corners android:radius="@dimen/btn_corner_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="@dimen/btn_stroke_width" android:color="?colorSurface" />
            <solid android:color="?colorSurface" />
            <corners android:radius="@dimen/btn_corner_medium" />
        </shape>
    </item>
</selector>
