<?xml version="1.0" encoding="utf-8"?>
<selector android:autoMirrored="true"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?colorSurfaceContainer" />
                    <corners android:radius="@dimen/btn_corner_small" />
                    <padding android:left="15.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
                    <stroke android:width="@dimen/btn_stroke_width" android:color="?colorSurfaceContainer" />
                </shape>
            </item>
            <item android:gravity="end|center" android:drawable="@drawable/ic_chevron_right_s" />
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape>
                    <solid android:color="?colorSurfaceContainer" />
                    <corners android:radius="@dimen/btn_corner_small" />
                    <padding android:left="10.0dp" android:top="10.0dp" android:right="10.0dp" android:bottom="10.0dp" />
                    <stroke android:width="@dimen/btn_stroke_width" android:color="?colorSurfaceContainer" />
                </shape>
            </item>
            <item android:gravity="end|center" android:drawable="@drawable/ic_chevron_right_s" />
        </layer-list>
    </item>
</selector>
